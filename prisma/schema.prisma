// ITIS Production Prisma Database Schema
// Phase 1 - Live Backend Foundation (Prompt 066)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SYSTEM_ADMIN
  NATIONAL_ADMIN
  PROVINCIAL_ADMIN
  COMMAND_OPERATOR
  SCHOOL_ADMIN
  TEACHER
  PARENT
  DEVICE_TECHNICIAN
  RESPONDER
  AUDITOR
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  SOS_PANIC
}

enum IncidentStatus {
  OPEN
  DISPATCHED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  idNumber        String?          @unique
  phoneNumber     String?
  mfaEnabled      Boolean          @default(false)
  mfaSecret       String?
  role            Role             @default(PARENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  parentProfile   Parent?
  sessions        Session[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  roleAssignments RoleAssignment[]

  @@map("users")
}

model Parent {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         String?
  emergencyPhone  String
  rsaIdVerified   Boolean     @default(false)

  learners        Learner[]

  @@map("parents")
}

model School {
  id              String       @id @default(uuid())
  emisCode        String       @unique
  name            String
  province        String
  district        String
  circuit         String?
  latitude        Float
  longitude       Float
  principalName   String?
  contactPhone    String
  contactEmail    String

  learners        Learner[]
  attendance      Attendance[]

  @@map("schools")
}

model Learner {
  id              String       @id @default(uuid())
  schoolId        String
  parentId        String
  school          School       @relation(fields: [schoolId], references: [id])
  parent          Parent       @relation(fields: [parentId], references: [id])
  firstName       String
  lastName        String
  nationalId      String       @unique
  grade           String
  classSection    String
  medicalNotes    String?
  wearableId      String?      @unique

  wearable        Wearable?    @relation(fields: [wearableId], references: [id])
  attendance      Attendance[]
  telemetry       Telemetry[]
  incidents       SOSIncident[]

  @@map("learners")
}

model Wearable {
  id              String       @id @default(uuid())
  serialNumber    String       @unique
  imei            String       @unique
  bleMac          String
  batteryLevel    Int          @default(100)
  firmwareVersion String       @default("2.4.1")
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now())

  learner         Learner?

  @@map("wearables")
}

model Telemetry {
  id              String       @id @default(uuid())
  learnerId       String
  learner         Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  latitude        Float
  longitude       Float
  speedKmh        Float        @default(0.0)
  heartRateBpm    Int          @default(72)
  batteryPercent  Int          @default(95)
  sosActive       Boolean      @default(false)
  timestamp       DateTime     @default(now())

  @@index([learnerId, timestamp])
  @@map("telemetry")
}

model SOSIncident {
  id              String           @id @default(uuid())
  incidentNumber  String           @unique
  learnerId       String
  learner         Learner          @relation(fields: [learnerId], references: [id])
  latitude        Float
  longitude       Float
  severity        IncidentSeverity @default(SOS_PANIC)
  status          IncidentStatus   @default(OPEN)
  description     String?
  dispatchedTo    String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("sos_incidents")
}

model Attendance {
  id              String           @id @default(uuid())
  learnerId       String
  schoolId        String
  learner         Learner          @relation(fields: [learnerId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  nfcCheckInTime  DateTime?
  nfcCheckOutTime DateTime?

  @@unique([learnerId, date])
  @@map("attendance")
}

model Notification {
  id              String       @id @default(uuid())
  recipientId     String
  title           String
  body            String
  channel         String       @default("PUSH")
  readStatus      Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@map("notifications")
}

model AuditLog {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action          String
  resource        String
  ipAddress       String?
  correlationId   String
  metadata        String?      @db.Text
  createdAt       DateTime     @default(now())

  @@map("audit_logs")
}

model Session {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String       @unique
  ipAddress       String?
  userAgent       String?      @db.Text
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  @@map("sessions")
}

model RefreshToken {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  isRevoked       Boolean      @default(false)
  expiresAt       DateTime
  createdAt       DateTime     @default(now())

  @@map("refresh_tokens")
}

model RoleAssignment {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role
  scopeProvince   String?
  scopeDistrict   String?
  assignedAt      DateTime     @default(now())

  @@map("role_assignments")
}
