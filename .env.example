# ==============================================================================
# ITIS Enterprise Platform - Complete Production Environment Variables Inventory
# ==============================================================================
# All variables are categorized below. Placeholders must be populated in Vault/KMS.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] Runtime Environment (development | testing | staging | production)
NODE_ENV=production
# [REQUIRED] [DEV/PROD] Express Application Listener Port
PORT=3000
# [REQUIRED] [PROD ONLY] Cluster Replica Identifier
POD_NAME=itis-backend-api-pod-0
# [REQUIRED] [PROD ONLY] SITA Data Center Region ID (e.g., sita-gauteng-primary-az1)
REGION_ID=sita-gauteng-primary-az1

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] Secret key for signing RSA/HMAC access JWT tokens
JWT_SECRET=itis_production_jwt_rsa_2026_secret_key_change_in_vault
# [REQUIRED] [DEV/PROD] Secret key for signing refresh JWT tokens
JWT_REFRESH_SECRET=itis_production_jwt_refresh_2026_secret_key_change_in_vault
# [REQUIRED] [PROD ONLY] Token expiration window (e.g., 15m, 1h)
JWT_EXPIRES_IN=15m
# [REQUIRED] [PROD ONLY] Argon2id password hash pepper key
ARGON2_SECRET=sita_argon2_master_pepper_key_2026
# [OPTIONAL] [PROD ONLY] SITA e-Government Single Sign-On (SSO) OAuth2 Client ID
SITA_SSO_CLIENT_ID=sita_sso_client_itis_prod
# [OPTIONAL] [PROD ONLY] SITA e-Government SSO OAuth2 Client Secret
SITA_SSO_CLIENT_SECRET=sita_sso_secret_key_placeholder
# [OPTIONAL] [PROD ONLY] SITA SAML2 Metadata Endpoint URL
SITA_SAML_METADATA_URL=https://sso.sita.gov.za/auth/realms/gov/protocol/saml/descriptor

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & TIMESCALEDB)
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] PostgreSQL Master Primary Connection URL (Prisma ORM)
DATABASE_URL=postgresql://itis_admin:Sita_Secure_Pass2026@postgres.internal.itis.gov.za:5432/itis_db?schema=public&sslmode=require
# [OPTIONAL] [PROD ONLY] Read-replica database connection URL for analytics/reporting
DATABASE_READ_REPLICA_URL=postgresql://itis_reader:Sita_Secure_Pass2026@postgres-read.internal.itis.gov.za:5432/itis_db?schema=public&sslmode=require
# [REQUIRED] [PROD ONLY] Database connection pool maximum size
DATABASE_POOL_MAX=50
# [REQUIRED] [PROD ONLY] Connection pool idle timeout in milliseconds
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & SESSION STORE
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] Redis primary instance connection URL
REDIS_URL=redis://:redis_secure_pass_2026@redis.internal.itis.gov.za:6379
# [OPTIONAL] [PROD ONLY] Redis Sentinel / Cluster nodes comma-separated list
REDIS_CLUSTER_NODES=redis-node-1.internal.itis.gov.za:6379,redis-node-2.internal.itis.gov.za:6379
# [REQUIRED] [PROD ONLY] Default cache TTL in seconds
REDIS_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. KAFKA EVENT STREAMING
# ------------------------------------------------------------------------------
# [OPTIONAL] [PROD ONLY] Kafka bootstrap broker endpoints
KAFKA_BOOTSTRAP_SERVERS=kafka-1.internal.itis.gov.za:9092,kafka-2.internal.itis.gov.za:9092
# [OPTIONAL] [PROD ONLY] Kafka consumer group ID for telematics ingestion
KAFKA_CONSUMER_GROUP_ID=itis-telematics-ingestion-group
# [OPTIONAL] [PROD ONLY] Confluent / Schema Registry endpoint URL
KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.internal.itis.gov.za:8081

# ------------------------------------------------------------------------------
# 6. MQTT BROKER (FLEET TELEMATICS)
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] MQTT Broker Connection Host / URL
MQTT_BROKER_URL=mqtts://emqx.internal.itis.gov.za:8883
# [REQUIRED] [PROD ONLY] MQTT Service Gateway Username
MQTT_USERNAME=itis_telematics_gateway
# [REQUIRED] [PROD ONLY] MQTT Service Gateway Password
MQTT_PASSWORD=emqx_telematics_secure_password_2026
# [REQUIRED] [PROD ONLY] Default MQTT QoS level (0 | 1 | 2)
MQTT_QOS=1

# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATION SERVICES
# ------------------------------------------------------------------------------
# [OPTIONAL] [PROD ONLY] SMTP Server Host for transactional emails
SMTP_HOST=smtp.gov.za
# [OPTIONAL] [PROD ONLY] SMTP Server Port (587 or 465)
SMTP_PORT=587
# [OPTIONAL] [PROD ONLY] SMTP Username
SMTP_USER=notifications@itis.gov.za
# [OPTIONAL] [PROD ONLY] SMTP Password
SMTP_PASS=smtp_secure_password_2026
# [OPTIONAL] [PROD ONLY] Default sender email address
EMAIL_FROM="ITIS National Safety Platform <no-reply@itis.gov.za>"

# ------------------------------------------------------------------------------
# 8. SMS & EMERGENCY GATEWAYS
# ------------------------------------------------------------------------------
# [OPTIONAL] [PROD ONLY] SITA Government SMS Gateway API Key
SITA_SMS_API_KEY=sita_sms_gateway_live_key_2026
# [OPTIONAL] [PROD ONLY] Emergency SMS Sender ID
SMS_SENDER_ID=ITIS_SAFETY
# [OPTIONAL] [DEV ONLY] Twilio Account SID fallback
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_sid
# [OPTIONAL] [DEV ONLY] Twilio Auth Token fallback
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token

# ------------------------------------------------------------------------------
# 9. PUSH NOTIFICATIONS (PARENT & RESPONDER APPS)
# ------------------------------------------------------------------------------
# [OPTIONAL] [PROD ONLY] Firebase Cloud Messaging (FCM) Service Account Key JSON (Base64)
FCM_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6Iml0aXMtcHJvZC1mY20ifQ==
# [OPTIONAL] [PROD ONLY] Apple Push Notification Service (APNS) Key ID
APNS_KEY_ID=APNS_KEY_2026_PLACEHOLDER

# ------------------------------------------------------------------------------
# 10. MAPS & GIS GEOLOCATION
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] Google Maps Platform API Key (Places, Distance Matrix, Geocoding)
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_key_itis_2026
# [OPTIONAL] [PROD ONLY] Mapbox GL Access Token for custom GIS vector layers
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiaXRpcy1nb3YiLCJhIjoiY2xwbGFjZWhvbGRlciJ9
# [REQUIRED] [PROD ONLY] OpenStreetMap / Nominatim internal reverse-geocoder endpoint
INTERNAL_GEOCODER_URL=https://gis-geocoder.internal.itis.gov.za/reverse

# ------------------------------------------------------------------------------
# 11. OBJECT STORAGE (EVIDENCE, EVIDENCE, FIRMWARE)
# ------------------------------------------------------------------------------
# [REQUIRED] [PROD ONLY] S3 / Google Cloud Storage Endpoint URL
STORAGE_ENDPOINT=https://storage.africa-south1.rep.sita.gov.za
# [REQUIRED] [PROD ONLY] Storage Bucket Name for pupil safety evidence
STORAGE_BUCKET_NAME=itis-evidence-vault-prod
# [REQUIRED] [PROD ONLY] Storage Access Key ID
STORAGE_ACCESS_KEY_ID=sita_s3_access_key_2026
# [REQUIRED] [PROD ONLY] Storage Secret Access Key
STORAGE_SECRET_ACCESS_KEY=sita_s3_secret_access_key_2026
# [REQUIRED] [PROD ONLY] Presigned URL signature expiry time in seconds
STORAGE_PRESIGNED_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# 12. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# [REQUIRED] [PROD ONLY] KMS Hardware Security Module Key ID for AES-256 GCM PII Encryption
SITA_ENCLAVE_HSM_KEY=arn:sita:kms:gauteng:123456789012:key/itis-pii-master-key
# [REQUIRED] [PROD ONLY] Allowed CORS Origins comma-separated list
CORS_ALLOWED_ORIGINS=https://itis.gov.za,https://app.itis.gov.za,https://admin.itis.gov.za
# [REQUIRED] [PROD ONLY] Global API Rate Limiting Max Requests per Minute
RATE_LIMIT_MAX_REQUESTS_PER_MIN=300

# ------------------------------------------------------------------------------
# 13. LOGGING & TRACING
# ------------------------------------------------------------------------------
# [REQUIRED] [DEV/PROD] Application Log Level (error | warn | info | http | debug)
LOG_LEVEL=info
# [REQUIRED] [PROD ONLY] Enable JSON structured logging for ELK / Loki ingestion
LOG_FORMAT=json
# [OPTIONAL] [PROD ONLY] OpenTelemetry (OTEL) Collector OTLP gRPC endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal.itis.gov.za:4317

# ------------------------------------------------------------------------------
# 14. MONITORING & OBSERVABILITY
# ------------------------------------------------------------------------------
# [REQUIRED] [PROD ONLY] Prometheus metrics scrape port (internal)
PROMETHEUS_METRICS_PORT=9090
# [OPTIONAL] [PROD ONLY] Sentry / GlitchTip Error Tracking DSN
SENTRY_DSN=https://sentry_key@sentry.itis.gov.za/1
# [OPTIONAL] [PROD ONLY] Datadog API Key
DATADOG_API_KEY=datadog_api_key_placeholder

# ------------------------------------------------------------------------------
# 15. THIRD-PARTY & GOVERNMENT INTEGRATIONS
# ------------------------------------------------------------------------------
# [REQUIRED] [PROD ONLY] SAPS National CAD Emergency Dispatch API Key
SAPS_DISPATCH_API_KEY=saps_live_key_2026_cad_dispatch
# [REQUIRED] [PROD ONLY] National Treasury CSD Vendor Database Verification Endpoint
CSD_VENDOR_API_URL=https://csd.treasury.gov.za/api/v1/suppliers
# [REQUIRED] [PROD ONLY] Department of Transport Driver License / PrDP Verification API
DOT_PRDP_VERIFY_URL=https://natis.transport.gov.za/api/v1/verify-prdp
# [OPTIONAL] [DEV/PROD] Server-side Gemini API key for fatigue analytics & incident summarization
GEMINI_API_KEY=
