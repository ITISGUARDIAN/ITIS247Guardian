# ==============================================================================
# ITIS Enterprise Platform v1.0.0-GA — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Active Environment: 'development' | 'staging' | 'production'
VITE_NODE_ENV=production

# Primary Commercial Domain (e.g., https://itis.co.za)
VITE_PRIMARY_DOMAIN=https://itis.co.za

# Government Domain (e.g., https://itis.gov.za)
VITE_GOV_DOMAIN=https://itis.gov.za

# API Gateway Base URL (leave blank for relative path detection)
VITE_API_BASE_URL=https://api.itis.co.za

# WS / Real-time Telemetry Gateway
VITE_WS_TELEMETRY_URL=wss://telemetry.itis.co.za

# ------------------------------------------------------------------------------
# 2. FEATURE FLAGS & CAPABILITIES
# ------------------------------------------------------------------------------
VITE_FEATURE_ENABLE_DEMO_MODE=true
VITE_FEATURE_ENABLE_SAPS_DISPATCH=true
VITE_FEATURE_ENABLE_OFFLINE_MESH=true
VITE_FEATURE_ENABLE_MAINTENANCE_MODE=false

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHING (SERVER-SIDE SECRETS)
# ------------------------------------------------------------------------------
# PostgreSQL Production Connection String
DATABASE_URL=postgresql://itis_admin:SECURE_PASSWORD@db.itis.co.za:5432/itis_prod?sslmode=require

# Redis Cache & Message Broker URL
REDIS_URL=rediss://default:SECURE_REDIS_PASS@redis.itis.co.za:6379

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE & AUDIT LOGS
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=itis-sa-prod-audit-bucket
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_rsa_2026
MTLS_ROOT_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
HASH_SALT_SECRET=itis_sha256_salted_hash_key_2026

# ------------------------------------------------------------------------------
# 6. MONITORING & CRASH REPORTING
# ------------------------------------------------------------------------------
VITE_SENTRY_DSN=https://sentry_key@sentry.io/itis-enterprise
VITE_UPTIME_MONITOR_URL=https://status.itis.co.za/health
